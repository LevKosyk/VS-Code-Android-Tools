          "icon": "$(vm)",
          "contextualTitle": "Emulator Control"
        },
        {
          "id": "androidToolkitGradleTasksView",
          "name": "Gradle Tasks",
          "icon": "$(tools)",
          "contextualTitle": "Gradle Tasks"
        },
        {
          "id": "androidProblemsView",
          "name": "Problems",
          "icon": "$(error)",
