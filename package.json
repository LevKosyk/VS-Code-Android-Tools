{
  "name": "vscode-android-tools",
  "displayName": "VS Code Android Tools",
  "description": "Fast, lightweight Android device and emulator management using CLI tools",
  "version": "0.1.2",
  "publisher": "levkosyk",
  "icon": "assets/logo/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/android-tools/vscode-android-tools"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "android-toolkit",
          "title": "Android Tools",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "android-toolkit": [
        {
          "id": "androidProjectView",
          "name": "Android Project",
          "icon": "$(folder-library)",
          "contextualTitle": "Android Project"
        },
        {
          "id": "deviceManagerView",
          "name": "Device Manager",
          "icon": "$(device-mobile)",
          "contextualTitle": "Device Manager"
        },
        {
          "id": "emulatorControlView",
          "name": "Emulator Control",
          "icon": "$(vm)",
          "contextualTitle": "Emulator Control"
        }
      ]
    },
    "commands": [
      {
        "command": "android-toolkit.listDevices",
        "title": "Android: List Devices"
      },
      {
        "command": "android-toolkit.startEmulator",
        "title": "Android: Start Emulator"
      },
      {
        "command": "android-toolkit.stopEmulator",
        "title": "Android: Stop Emulator"
      },
      {
        "command": "android-toolkit.createEmulator",
        "title": "Android: Create Emulator"
      },
      {
        "command": "android-toolkit.refreshProjectView",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.openInExplorer",
        "title": "Open in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "android-toolkit.refreshEmulatorControl",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.emulator.rotate",
        "title": "Android: Rotate Screen"
      },
      {
        "command": "android-toolkit.emulator.screenshot",
        "title": "Android: Take Screenshot"
      },
      {
        "command": "android-toolkit.emulator.coldBoot",
        "title": "Android: Cold Boot"
      },
      {
        "command": "android-toolkit.emulator.warmBoot",
        "title": "Android: Warm Boot"
      },
      {
        "command": "android-toolkit.emulator.wipeData",
        "title": "Android: Wipe Data"
      },
      {
        "command": "android-toolkit.emulator.toggleNetwork",
        "title": "Android: Toggle Network"
      },
      {
        "command": "android-toolkit.openLogcat",
        "title": "Android: Open Logcat Viewer",
        "icon": "$(output)"
      },
      {
        "command": "android-toolkit.clearLogcat",
        "title": "Android: Clear Logcat"
      },
      {
        "command": "android-toolkit.attachDebugger",
        "title": "Android: Attach Debugger",
        "icon": "$(debug-start)"
      },
      {
        "command": "android-toolkit.detachDebugger",
        "title": "Android: Detach Debugger",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "android-toolkit.toggleBreakpoint",
        "title": "Android: Toggle Breakpoint"
      },
      {
        "command": "android-toolkit.debugStatus",
        "title": "Android: Debug Status"
      },
      {
        "command": "android-toolkit.createResource",
        "title": "Android: Create Resource",
        "icon": "$(add)"
      },
      {
        "command": "android-toolkit.createClass",
        "title": "Android: Create Class",
        "icon": "$(symbol-class)"
      },
      {
        "command": "android-toolkit.createFile",
        "title": "Android: Create File",
        "icon": "$(new-file)"
      },
      {
        "command": "android-toolkit.createFolderGeneric",
        "title": "Android: Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "android-toolkit.renameItem",
        "title": "Android: Rename"
      },
      {
        "command": "android-toolkit.deleteItem",
        "title": "Android: Delete"
      },
      {
        "command": "android-toolkit.createProject",
        "title": "Android: New Project",
        "icon": "$(rocket)"
      },
      {
        "command": "android-toolkit.runAppOnEmulator",
        "title": "Android: Run App on Emulator",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.createFolder",
        "title": "Android: Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "android-toolkit.createAsset",
        "title": "Android: Create Asset",
        "icon": "$(file-add)"
      },
      {
        "command": "android-toolkit.createLocale",
        "title": "Android: Create Language/Locale",
        "icon": "$(globe)"
      },
      {
        "command": "android-toolkit.createDevice",
        "title": "Mobile: Create Device",
        "icon": "$(add)"
      },
      {
        "command": "android-toolkit.refreshDeviceManager",
        "title": "Mobile: Refresh Device Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.deviceManager.launch",
        "title": "Launch Device",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.deviceManager.stop",
        "title": "Stop Device",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-toolkit.deviceManager.delete",
        "title": "Delete Device",
        "icon": "$(trash)"
      },
      {
        "command": "android-toolkit.openEmulatorPanel",
        "title": "Android: Open Emulator Control",
        "icon": "$(vm)"
      },
      {
        "command": "android-toolkit.installApk",
        "title": "Android: Install APK",
        "icon": "$(package)"
      },
      {
        "command": "android-toolkit.uninstallApp",
        "title": "Android: Uninstall App"
      },
      {
        "command": "android-toolkit.restartApp",
        "title": "Android: Restart App"
      },
      {
        "command": "android-toolkit.setLocation",
        "title": "Android: Set Location",
        "icon": "$(location)"
      },
      {
        "command": "android-toolkit.startRecording",
        "title": "Android: Start Screen Recording",
        "icon": "$(circle-filled)"
      },
      {
        "command": "android-toolkit.stopRecording",
        "title": "Android: Stop Screen Recording",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-toolkit.setBattery",
        "title": "Android: Set Battery Level"
      },
      {
        "command": "android-toolkit.openProfiler",
        "title": "Android: Open Performance Profiler",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "android-toolkit.refreshProjectView",
          "when": "view == androidProjectView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createProject",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshDeviceManager",
          "when": "view == deviceManagerView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createDevice",
          "when": "view == deviceManagerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshEmulatorControl",
          "when": "view == emulatorControlView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "android-toolkit.openInExplorer",
          "when": "view == androidProjectView && viewItem =~ /folder|file/",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createFolder",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@2"
        },
        {
          "command": "android-toolkit.createLocale",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@3"
        },
        {
          "command": "android-toolkit.createAsset",
          "when": "view == androidProjectView && viewItem == category-assets",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView && (viewItem == category-java || viewItem == package || viewItem == folder)",
          "group": "1_create@4"
        },
        {
          "command": "android-toolkit.createFile",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@5"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@6"
        },
        {
          "command": "android-toolkit.renameItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@1"
        },
        {
          "command": "android-toolkit.deleteItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
