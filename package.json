{
  "name": "vscode-android-tools",
  "displayName": "VS Code Android Tools",
  "description": "Run, debug, and manage Android apps in VS Code with a focused Android toolkit",
  "version": "0.2.0",
  "publisher": "levkosyk",
  "license": "MIT",
  "icon": "assets/logo/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevKosyk/Android-Tools"
  },
  "homepage": "https://github.com/LevKosyk/Android-Tools#readme",
  "bugs": {
    "url": "https://github.com/LevKosyk/Android-Tools/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "android",
    "adb",
    "emulator",
    "gradle",
    "logcat",
    "kotlin",
    "java",
    "apk"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "android-toolkit",
          "title": "Android Tools",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "android-toolkit": [
        {
          "id": "androidProjectView",
          "name": "Android Project",
          "icon": "$(folder-library)",
          "contextualTitle": "Android Project"
        },
        {
          "id": "deviceManagerView",
          "name": "Device Manager",
          "icon": "$(device-mobile)",
          "contextualTitle": "Device Manager"
        },
        {
          "id": "deviceFileExplorerView",
