{
  "name": "vscode-android-tools",
  "displayName": "VS Code Android Tools",
  "description": "Fast, lightweight Android device and emulator management using CLI tools",
  "version": "0.1.4",
  "publisher": "levkosyk",
  "icon": "assets/logo/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/android-tools/vscode-android-tools"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "android-toolkit",
          "title": "Android Tools",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "android-toolkit": [
        {
          "id": "androidProjectView",
          "name": "Android Project",
          "icon": "$(folder-library)",
          "contextualTitle": "Android Project"
        },
        {
          "id": "deviceManagerView",
          "name": "Device Manager",
          "icon": "$(device-mobile)",
          "contextualTitle": "Device Manager"
        },
        {
          "id": "deviceFileExplorerView",
          "name": "Device Explorer",
          "icon": "$(folder-opened)",
          "contextualTitle": "Device Explorer"
        },
        {
          "id": "emulatorControlView",
          "name": "Emulator Control",
          "icon": "$(vm)",
          "contextualTitle": "Emulator Control"
        },
        {
          "id": "androidToolkitGradleTasksView",
          "name": "Gradle Tasks",
          "icon": "$(tools)",
          "contextualTitle": "Gradle Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "android-toolkit.listDevices",
        "title": "Android: List Devices"
      },
      {
        "command": "android-toolkit.startEmulator",
        "title": "Android: Start Emulator"
      },
      {
        "command": "android-toolkit.stopEmulator",
        "title": "Android: Stop Emulator"
      },
      {
        "command": "android-toolkit.createEmulator",
        "title": "Android: Create Emulator"
      },
      {
        "command": "android-toolkit.refreshProjectView",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.openInExplorer",
        "title": "Open in Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "android-toolkit.refreshEmulatorControl",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.emulator.rotate",
        "title": "Android: Rotate Screen"
      },
      {
        "command": "android-toolkit.emulator.screenshot",
        "title": "Android: Take Screenshot"
      },
      {
        "command": "android-toolkit.emulator.coldBoot",
        "title": "Android: Cold Boot"
      },
      {
        "command": "android-toolkit.emulator.warmBoot",
        "title": "Android: Warm Boot"
      },
      {
        "command": "android-toolkit.emulator.wipeData",
        "title": "Android: Wipe Data"
      },
      {
        "command": "android-toolkit.emulator.toggleNetwork",
        "title": "Android: Toggle Network"
      },
      {
        "command": "android-toolkit.openLogcat",
        "title": "Android: Open Logcat Viewer",
        "icon": "$(output)"
      },
      {
        "command": "android-toolkit.clearLogcat",
        "title": "Android: Clear Logcat"
      },
      {
        "command": "android-toolkit.attachDebugger",
        "title": "Android: Attach Debugger",
        "icon": "$(debug-start)"
      },
      {
        "command": "android-toolkit.detachDebugger",
        "title": "Android: Detach Debugger",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "android-toolkit.toggleBreakpoint",
        "title": "Android: Toggle Breakpoint"
      },
      {
        "command": "android-toolkit.debugStatus",
        "title": "Android: Debug Status"
      },
      {
        "command": "android-toolkit.createResource",
        "title": "Android: Create Resource",
        "icon": "$(add)"
      },
      {
        "command": "android-toolkit.createClass",
        "title": "Android: Create Class",
        "icon": "$(symbol-class)"
      },
      {
        "command": "android-toolkit.createFile",
        "title": "Android: Create File",
        "icon": "$(new-file)"
      },
      {
        "command": "android-toolkit.createFolderGeneric",
        "title": "Android: Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "android-toolkit.renameItem",
        "title": "Android: Rename"
      },
      {
        "command": "android-toolkit.deleteItem",
        "title": "Android: Delete"
      },
      {
        "command": "android-toolkit.createProject",
        "title": "Android: New Project",
        "icon": "$(rocket)"
      },
      {
        "command": "android-toolkit.runAppOnEmulator",
        "title": "Android: Run App on Emulator",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.runAppOnDevice",
        "title": "Android: Run App on Device",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.openRunPanel",
        "title": "Android: Open Run Panel",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.selectBuildVariant",
        "title": "Android: Select Build Variant"
      },
      {
        "command": "android-toolkit.gradleAssembleDebug",
        "title": "Android: Gradle Assemble Debug"
      },
      {
        "command": "android-toolkit.gradleInstallDebug",
        "title": "Android: Gradle Install Debug"
      },
      {
        "command": "android-toolkit.gradleClean",
        "title": "Android: Gradle Clean"
      },
      {
        "command": "android-toolkit.refreshGradleTasks",
        "title": "Android: Refresh Gradle Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.runGradleTask",
        "title": "Android: Run Gradle Task"
      },
      {
        "command": "android-toolkit.createLaunchProfile",
        "title": "Android: Create Launch Profile"
      },
      {
        "command": "android-toolkit.runLaunchProfile",
        "title": "Android: Run Launch Profile"
      },
      {
        "command": "android-toolkit.deleteLaunchProfile",
        "title": "Android: Delete Launch Profile"
      },
      {
        "command": "android-toolkit.analyzeApk",
        "title": "Android: APK Analyzer",
        "icon": "$(graph)"
      },
      {
        "command": "android-toolkit.compareApk",
        "title": "Android: Compare APKs",
        "icon": "$(diff)"
      },
      {
        "command": "android-toolkit.signingWizard",
        "title": "Android: Signing Wizard"
      },
      {
        "command": "android-toolkit.buildSignedApk",
        "title": "Android: Build Signed APK"
      },
      {
        "command": "android-toolkit.buildSignedBundle",
        "title": "Android: Build Signed AAB"
      },
      {
        "command": "android-toolkit.openAppInspection",
        "title": "Android: App Inspection",
        "icon": "$(search)"
      },
      {
        "command": "android-toolkit.openDatabaseInspector",
        "title": "Android: Database Inspector",
        "icon": "$(database)"
      },
      {
        "command": "android-toolkit.openDebugPanel",
        "title": "Android: Debug Panel",
        "icon": "$(debug)"
      },
      {
        "command": "android-toolkit.openAdbShell",
        "title": "Android: Open ADB Shell",
        "icon": "$(terminal)"
      },
      {
        "command": "android-toolkit.openLayoutPreview",
        "title": "Android: Preview Layout",
        "icon": "$(preview)"
      },
      {
        "command": "android-toolkit.openLayoutInspector",
        "title": "Android: Layout Inspector",
        "icon": "$(preview)"
      },
      {
        "command": "android-toolkit.emulator.saveSnapshot",
        "title": "Android: Save Emulator Snapshot"
      },
      {
        "command": "android-toolkit.emulator.loadSnapshot",
        "title": "Android: Load Emulator Snapshot"
      },
      {
        "command": "android-toolkit.validateManifest",
        "title": "Android: Validate Manifest"
      },
      {
        "command": "android-toolkit.insertManifestTemplate",
        "title": "Android: Insert Manifest Template"
      },
      {
        "command": "android-toolkit.addManifestEntry",
        "title": "Android: Add Manifest Entry"
      },
      {
        "command": "android-toolkit.openManifestEditor",
        "title": "Android: Open Manifest Editor"
      },
      {
        "command": "android-toolkit.validateResources",
        "title": "Android: Validate Resources"
      },
      {
        "command": "android-toolkit.insertValuesTemplate",
        "title": "Android: Insert Values Template"
      },
      {
        "command": "android-toolkit.openResourceInspector",
        "title": "Android: Resource Inspector"
      },
      {
        "command": "android-toolkit.openResourceByQuery",
        "title": "Android: Go To Resource (R.)"
      },
      {
        "command": "android-toolkit.selectDevice",
        "title": "Android: Select Device"
      },
      {
        "command": "android-toolkit.selectModule",
        "title": "Android: Select Module"
      },
      {
        "command": "android-toolkit.runAppOnTargetSelected",
        "title": "Android: Run (Selected Target)"
      },
      {
        "command": "android-toolkit.stopApp",
        "title": "Android: Stop App"
      },
      {
        "command": "android-toolkit.gradleSync",
        "title": "Android: Gradle Sync"
      },
      {
        "command": "android-toolkit.projectHealth",
        "title": "Android: Project Health Check"
      },
      {
        "command": "android-toolkit.deviceExplorer.refresh",
        "title": "Android: Refresh Device Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.deviceExplorer.pull",
        "title": "Android: Pull From Device"
      },
      {
        "command": "android-toolkit.deviceExplorer.push",
        "title": "Android: Push To Device"
      },
      {
        "command": "android-toolkit.deviceExplorer.delete",
        "title": "Android: Delete From Device"
      },
      {
        "command": "android-toolkit.runAppOnDevice",
        "title": "Android: Run App on Device",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.gradleAssembleDebug",
        "title": "Android: Gradle Assemble Debug"
      },
      {
        "command": "android-toolkit.gradleInstallDebug",
        "title": "Android: Gradle Install Debug"
      },
      {
        "command": "android-toolkit.gradleClean",
        "title": "Android: Gradle Clean"
      },
      {
        "command": "android-toolkit.openRunPanel",
        "title": "Android: Open Run Panel",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.createFolder",
        "title": "Android: Create Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "android-toolkit.createAsset",
        "title": "Android: Create Asset",
        "icon": "$(file-add)"
      },
      {
        "command": "android-toolkit.createLocale",
        "title": "Android: Create Language/Locale",
        "icon": "$(globe)"
      },
      {
        "command": "android-toolkit.createDevice",
        "title": "Mobile: Create Device",
        "icon": "$(add)"
      },
      {
        "command": "android-toolkit.refreshDeviceManager",
        "title": "Mobile: Refresh Device Manager",
        "icon": "$(refresh)"
      },
      {
        "command": "android-toolkit.deviceManager.launch",
        "title": "Launch Device",
        "icon": "$(play)"
      },
      {
        "command": "android-toolkit.deviceManager.stop",
        "title": "Stop Device",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-toolkit.deviceManager.delete",
        "title": "Delete Device",
        "icon": "$(trash)"
      },
      {
        "command": "android-toolkit.openEmulatorPanel",
        "title": "Android: Open Emulator Control",
        "icon": "$(vm)"
      },
      {
        "command": "android-toolkit.installApk",
        "title": "Android: Install APK",
        "icon": "$(package)"
      },
      {
        "command": "android-toolkit.uninstallApp",
        "title": "Android: Uninstall App"
      },
      {
        "command": "android-toolkit.restartApp",
        "title": "Android: Restart App"
      },
      {
        "command": "android-toolkit.setLocation",
        "title": "Android: Set Location",
        "icon": "$(location)"
      },
      {
        "command": "android-toolkit.startRecording",
        "title": "Android: Start Screen Recording",
        "icon": "$(circle-filled)"
      },
      {
        "command": "android-toolkit.stopRecording",
        "title": "Android: Stop Screen Recording",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-toolkit.setBattery",
        "title": "Android: Set Battery Level"
      },
      {
        "command": "android-toolkit.openProfiler",
        "title": "Android: Open Performance Profiler",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "android-toolkit.refreshProjectView",
          "when": "view == androidProjectView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createProject",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.openRunPanel",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.runAppOnDevice",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshDeviceManager",
          "when": "view == deviceManagerView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createDevice",
          "when": "view == deviceManagerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.refresh",
          "when": "view == deviceFileExplorerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshEmulatorControl",
          "when": "view == emulatorControlView",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.refreshGradleTasks",
          "when": "view == androidToolkitGradleTasksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "android-toolkit.openInExplorer",
          "when": "view == androidProjectView && viewItem =~ /folder|file/",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createFolder",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@2"
        },
        {
          "command": "android-toolkit.createLocale",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@3"
        },
        {
          "command": "android-toolkit.createAsset",
          "when": "view == androidProjectView && viewItem == category-assets",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView && (viewItem == category-java || viewItem == package || viewItem == folder)",
          "group": "1_create@4"
        },
        {
          "command": "android-toolkit.createFile",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@5"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@6"
        },
        {
          "command": "android-toolkit.renameItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@1"
        },
        {
          "command": "android-toolkit.deleteItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@2"
        },
        {
          "command": "android-toolkit.runGradleTask",
          "when": "view == androidToolkitGradleTasksView && viewItem == task",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.deviceExplorer.pull",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.push",
          "when": "view == deviceFileExplorerView && (viewItem == device || viewItem == folder)",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.deviceExplorer.delete",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
