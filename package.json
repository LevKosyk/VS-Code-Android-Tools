{
  "name": "vscode-android-tools",
  "displayName": "Android Tools for VS Code",
  "description": "VS Code Android extension for ADB, emulator/device manager, Logcat, Gradle Run/Debug, APK install, and XML live preview",
  "version": "0.2.4",
  "publisher": "levkosyk",
  "license": "MIT",
  "icon": "assets/logo/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LevKosyk/Android-Tools"
  },
  "homepage": "https://github.com/LevKosyk/Android-Tools#readme",
  "bugs": {
    "url": "https://github.com/LevKosyk/Android-Tools/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Other"
  ],
  "markdown": "github",
  "keywords": [
    "android",
    "vscode android",
    "vs code android extension",
    "android studio",
    "android development",
    "adb",
    "avd",
    "emulator",
    "emulator manager",
    "device manager",
    "gradle",
    "logcat",
    "android debugger",
    "android run",
    "android xml",
    "layout preview",
    "xml live preview",
    "android run debug",
    "android emulator vscode",
    "android logcat vscode",
    "gradle vscode",
    "compose",
    "kotlin",
    "java",
    "apk"
  ],
  "qna": "marketplace",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
