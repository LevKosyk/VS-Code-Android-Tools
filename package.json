    "menus": {
      "view/title": [
        {
          "command": "android-toolkit.refreshProjectView",
          "when": "view == androidProjectView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createProject",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.openRunPanel",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.runAppOnDevice",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.undoLastProjectAction",
          "when": "view == androidProjectView",
          "group": "navigation@3"
        },
        {
          "command": "android-toolkit.refreshDeviceManager",
          "when": "view == deviceManagerView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createDevice",
          "when": "view == deviceManagerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.refresh",
          "when": "view == deviceFileExplorerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshEmulatorControl",
          "when": "view == emulatorControlView",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.refreshGradleTasks",
          "when": "view == androidToolkitGradleTasksView",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.clearProblems",
          "when": "view == androidProblemsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "android-toolkit.openInExplorer",
          "when": "view == androidProjectView && viewItem =~ /folder|file/",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createFolder",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@2"
        },
        {
          "command": "android-toolkit.createLocale",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@3"
        },
        {
          "command": "android-toolkit.createAsset",
          "when": "view == androidProjectView && viewItem == category-assets",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView && (viewItem == category-java || viewItem == package || viewItem == folder)",
          "group": "1_create@4"
        },
        {
          "command": "android-toolkit.createFile",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@5"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@6"
        },
        {
          "command": "android-toolkit.renameItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@1"
        },
        {
          "command": "android-toolkit.deleteItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@2"
        },
        {
          "command": "android-toolkit.runGradleTask",
          "when": "view == androidToolkitGradleTasksView && viewItem == task",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.deviceExplorer.pull",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.push",
          "when": "view == deviceFileExplorerView && (viewItem == device || viewItem == folder)",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.deviceExplorer.delete",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@3"
        },
        {
          "command": "android-toolkit.problemApplyFix",
          "when": "view == androidProblemsView && viewItem == android-problem-fix",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.problemOpenLocation",
          "when": "view == androidProblemsView && viewItem == android-problem-location",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "android-toolkit.runSelectedAlias",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.stopSelectedAlias",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.logcatThisApp",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.openXmlLivePreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.toggleXmlLivePreview",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.generateConstraintSetSnippet",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.extractStringResourceFromXml",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == xml"
      }
    ],
    "configuration": {
      "title": "Android Tools",
      "properties": {
        "androidToolkit.notifications.mode": {
          "type": "string",
          "enum": [
            "quiet",
            "normal"
          ],
          "default": "quiet",
          "markdownDescription": "Controls Android Tools notification behavior. `quiet` minimizes pop-ups (status bar + output for info/warn). `normal` still reduces noise (info stays in status bar; warnings/errors are throttled)."
        },
        "androidToolkit.performance.deferBackgroundMonitoring": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Defer background emulator/device monitoring during activation to improve startup performance."
        },
        "androidToolkit.sync.autoSync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically refresh device/emulator-related views when connected devices state changes."
        },
        "androidToolkit.sync.autoSync.intervalMs": {
          "type": "number",
          "default": 4000,
          "minimum": 1500,
          "markdownDescription": "Polling interval for auto-sync checks (milliseconds). Lower values refresh faster but use more resources."
        },
        "androidToolkit.xml.lintOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run lightweight layout XML lint checks when saving `res/layout/*.xml` files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test test/**/*.test.js",
    "test:p0": "npm run compile && node --test test/p0-run-scenarios-smoke.test.js test/commands-smoke.test.js",
    "test:runtime": "npm run compile && node test/vscode/runTest.js",
    "release:check": "npm run compile && npm run lint && npm test --silent && npm run test:p0",
    "release:package": "npm run release:check && npx --yes @vscode/vsce package --no-yarn"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
