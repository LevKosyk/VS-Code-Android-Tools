        "title": "Android: Run Device Farm Preset (Release)"
      },
      {
        "command": "android-toolkit.runDeviceFarmSmoke",
        "title": "Android: Run Device Farm Preset (Smoke)"
      },
      {
        "command": "android-toolkit.deleteDeviceFarmPreset",
        "title": "Android: Delete Device Farm Preset"
      },
      {
        "command": "android-toolkit.openLastFailedStep",
        "title": "Android: Open Last Failed Step"
      },
      {
        "command": "android-toolkit.exportDiagnosticsBundle",
        "title": "Android: Export Diagnostics Bundle"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "android-toolkit.refreshProjectView",
          "when": "view == androidProjectView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.setProjectViewMode",
          "when": "view == androidProjectView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.createProject",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.openTemplateGallery",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.openRunPanel",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.runAppOnDevice",
          "when": "view == androidProjectView",
          "group": "navigation@0"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.undoLastProjectAction",
          "when": "view == androidProjectView",
          "group": "navigation@3"
        },
        {
          "command": "android-toolkit.refreshDeviceManager",
          "when": "view == deviceManagerView",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.createDevice",
          "when": "view == deviceManagerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.refresh",
          "when": "view == deviceFileExplorerView",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.refreshEmulatorControl",
          "when": "view == emulatorControlView",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.refreshGradleTasks",
          "when": "view == androidToolkitGradleTasksView",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.clearProblems",
          "when": "view == androidProblemsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "android-toolkit.openInExplorer",
          "when": "view == androidProjectView && viewItem =~ /folder|file/",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.createResource",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createFolder",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@2"
        },
        {
          "command": "android-toolkit.createLocale",
          "when": "view == androidProjectView && viewItem =~ /category-res|folder-res/",
          "group": "1_create@3"
        },
        {
          "command": "android-toolkit.createAsset",
          "when": "view == androidProjectView && viewItem == category-assets",
          "group": "1_create@1"
        },
        {
          "command": "android-toolkit.createClass",
          "when": "view == androidProjectView && (viewItem == category-java || viewItem == package || viewItem == folder)",
          "group": "1_create@4"
        },
        {
          "command": "android-toolkit.createFile",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@5"
        },
        {
          "command": "android-toolkit.createFolderGeneric",
          "when": "view == androidProjectView && (viewItem == folder || viewItem == package || viewItem =~ /folder-res/ || viewItem == category-java || viewItem == category-assets || viewItem == category-gradle)",
          "group": "1_create@6"
        },
        {
          "command": "android-toolkit.renameItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@1"
        },
        {
          "command": "android-toolkit.deleteItem",
          "when": "view == androidProjectView && (viewItem == file || viewItem == folder || viewItem == package || viewItem =~ /folder-res/)",
          "group": "2_manage@2"
        },
        {
          "command": "android-toolkit.runGradleTask",
          "when": "view == androidToolkitGradleTasksView && viewItem == task",
          "group": "navigation"
        },
        {
          "command": "android-toolkit.deviceExplorer.pull",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.deviceExplorer.push",
          "when": "view == deviceFileExplorerView && (viewItem == device || viewItem == folder)",
          "group": "navigation@2"
        },
        {
          "command": "android-toolkit.deviceExplorer.delete",
          "when": "view == deviceFileExplorerView && (viewItem == file || viewItem == folder)",
          "group": "navigation@3"
        },
        {
          "command": "android-toolkit.problemApplyFix",
          "when": "view == androidProblemsView && viewItem == android-problem-fix",
          "group": "navigation@1"
        },
        {
          "command": "android-toolkit.problemOpenLocation",
          "when": "view == androidProblemsView && viewItem == android-problem-location",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "android-toolkit.runSelectedAlias",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.stopSelectedAlias",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.openRunPanel",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.problemApplyFix",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "view == androidProblemsView && viewItem == android-problem-fix"
      },
      {
        "command": "android-toolkit.logcatThisApp",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus || terminalFocus || view == androidProjectView"
      },
      {
        "command": "android-toolkit.openXmlLivePreview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.toggleXmlLivePreview",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.generateConstraintSetSnippet",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+alt+shift+c",
        "when": "editorTextFocus && editorLangId == xml"
      },
      {
        "command": "android-toolkit.extractStringResourceFromXml",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == xml"
      }
    ],
    "configuration": {
      "title": "Android Tools",
      "properties": {
        "androidToolkit.notifications.mode": {
          "type": "string",
          "enum": [
            "quiet",
            "normal"
          ],
          "default": "quiet",
          "markdownDescription": "Controls Android Tools notification behavior. `quiet` minimizes pop-ups (status bar + output for info/warn). `normal` still reduces noise (info stays in status bar; warnings/errors are throttled)."
        },
        "androidToolkit.performance.deferBackgroundMonitoring": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Defer background emulator/device monitoring during activation to improve startup performance."
        },
        "androidToolkit.sync.autoSync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically refresh device/emulator-related views when connected devices state changes."
        },
        "androidToolkit.sync.autoSync.intervalMs": {
          "type": "number",
          "default": 4000,
          "minimum": 1500,
          "markdownDescription": "Polling interval for auto-sync checks (milliseconds). Lower values refresh faster but use more resources."
        },
        "androidToolkit.xml.lintOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run lightweight layout XML lint checks when saving `res/layout/*.xml` files."
        },
        "androidToolkit.ui.mode": {
          "type": "string",
          "enum": [
            "beginner",
            "standard",
            "power"
          ],
          "default": "beginner",
          "markdownDescription": "Preset UI mode. `beginner` hides complex tools (Matrix/Gradle Intelligence/Diagnostics), `standard` is balanced, `power` shows all advanced tools."
        },
        "androidToolkit.projectView.mode": {
          "type": "string",
          "enum": [
            "android",
            "files",
            "packages"
          ],
          "default": "android",
          "markdownDescription": "Project tree layout mode. `android` = Android Studio-like logical groups, `files` = full filesystem tree, `packages` = Java/Kotlin package-oriented tree."
        },
        "androidToolkit.config.profile": {
          "type": "string",
          "enum": [
            "solo",
            "team",
            "ci-heavy",
            "release",
            "custom"
          ],
          "default": "solo",
          "markdownDescription": "Active Android Tools config profile. Use `Android: Apply Config Profile` to switch quickly."
        },
        "androidToolkit.runPanel.actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "build",
              "install",
              "run",
              "stop",
              "clean",
              "releaseGate"
            ]
          },
          "default": [
            "build",
            "install",
            "run",
            "stop",
            "clean",
            "releaseGate"
          ],
          "markdownDescription": "Ordered list of visible primary actions in Run Panel. Use `Android: Configure Run Layout` for quick setup."
        },
        "androidToolkit.run.autoRetry.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable auto-retry for known flaky run stages (ADB install, wait-for-device)."
        },
        "androidToolkit.run.autoRetry.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "markdownDescription": "Max retry attempts for flaky run stages when auto-retry is enabled."
        },
        "androidToolkit.notifications.channels.run": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show run-related info/warn notifications."
        },
        "androidToolkit.notifications.channels.gradle": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Gradle-related info/warn notifications."
        },
        "androidToolkit.notifications.channels.device": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show device/emulator-related info/warn notifications."
        },
        "androidToolkit.notifications.channels.logcat": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Logcat-related info/warn notifications."
        },
        "androidToolkit.notifications.channels.tips": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show general tips/info notifications."
        },
        "androidToolkit.notifications.channels.errorsOnly": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When enabled, suppresses all info/warn notifications and shows only errors."
        },
        "androidToolkit.theme.tokens.success": {
          "type": "string",
          "default": "#22c55e",
          "markdownDescription": "Webview success accent color (hex, e.g. #22c55e)."
        },
        "androidToolkit.theme.tokens.warn": {
          "type": "string",
          "default": "#f59e0b",
          "markdownDescription": "Webview warning accent color (hex, e.g. #f59e0b)."
        },
        "androidToolkit.theme.tokens.error": {
          "type": "string",
          "default": "#ef4444",
          "markdownDescription": "Webview error accent color (hex, e.g. #ef4444)."
        },
        "androidToolkit.theme.tokens.info": {
          "type": "string",
          "default": "#0ea5e9",
          "markdownDescription": "Webview info accent color (hex, e.g. #0ea5e9)."
        },
        "androidToolkit.keyboard.shortcuts": {
          "type": "object",
          "default": {
            "run": "Enter",
            "stop": "Mod+Shift+S",
            "rerun": "Mod+R",
            "releaseGate": "Mod+Shift+G",
            "refresh": "Mod+Shift+R"
          },
          "markdownDescription": "Keyboard-first shortcuts for Android Run Panel actions."
        },
        "androidToolkit.ui.density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable"
          ],
          "default": "comfortable",
          "markdownDescription": "Panel density for Android Tools webviews."
        },
        "androidToolkit.ui.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 11,
          "maximum": 18,
          "markdownDescription": "Base font size for Android Tools webviews."
        },
        "androidToolkit.ui.tableRowHeight": {
          "type": "number",
          "default": 34,
          "minimum": 22,
          "maximum": 52,
          "markdownDescription": "Preferred table row height (px) for Android Tools panels."
        },
        "androidToolkit.ui.logRowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 16,
          "maximum": 42,
          "markdownDescription": "Preferred log/list row height (px) for Android Tools panels."
        },
        "androidToolkit.keyboard.profile": {
          "type": "string",
          "enum": [
            "default",
            "vim",
            "jetbrains",
            "custom"
          ],
          "default": "default",
          "markdownDescription": "Keyboard shortcut profile for Run Panel actions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run prepublish:gate",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node test/run-node-tests.js",
    "test:p0": "npm run compile && node --test test/p0-run-scenarios-smoke.test.js test/commands-smoke.test.js",
    "test:runtime": "npm run compile && node test/vscode/runTest.js",
    "qa:real-projects": "node scripts/run-real-project-checks.js",
    "release:notes": "node scripts/check-release.js",
    "release:sync-notes": "node scripts/sync-release-notes-from-git.js",
    "release:sync-notes:dry": "node scripts/sync-release-notes-from-git.js --dry-run",
    "release:publish:dry-run": "npx --yes @vscode/vsce package --no-yarn --out .artifacts/android-tools-dry-run.vsix",
    "release:automate": "node scripts/release-automate.js patch",
    "release:automate:minor": "node scripts/release-automate.js minor",
    "release:automate:major": "node scripts/release-automate.js major",
    "release:github": "node scripts/publish-github-releases.js",
    "release:github:prepare": "node scripts/publish-github-releases.js --prepare-only",
    "prepublish:gate": "npm run compile && npm run lint && npm test --silent && npm run test:p0 && node scripts/check-release.js",
    "release:check": "npm run prepublish:gate && npm run test:runtime && npm run release:publish:dry-run",
    "release:package": "npm run release:check && npx --yes @vscode/vsce package --no-yarn"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
